# Copy this file to .env and edit. Leave a value empty to switch that feature off.

# ---- Ask (optional) — choose ONE ----
# Option A: Claude API (best answers; needs internet and an API key from console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Option B: a local model with Ollama (fully offline; needs a reasonably strong computer)
OLLAMA_URL=
OLLAMA_MODEL=llama3.1:8b
# How much text the local model reads at once. Long papers need a large value; more uses more memory.
OLLAMA_NUM_CTX=32768

# ---- Auto-fill ----
# When a PDF contains a DOI, the server looks up its exact details in CrossRef (needs internet; nothing else is sent).
# Set CROSSREF=off to disable. Optionally add your email so CrossRef can contact you if needed (their "polite pool").
CROSSREF=on
CROSSREF_MAILTO=

# ---- Security ----
# Set a password if anyone else on your network can reach the app (username can be anything).
APP_PASSWORD=

# ---- Updates ----
# Shared secret between the app and its updater container (any long random text).
UPDATE_TOKEN=change-this-to-any-long-random-text
# Only needed if the GitHub repository is private: a token that can read its releases.
UPDATE_GITHUB_TOKEN=

# ---- Limits ----
MAX_UPLOAD_MB=50
